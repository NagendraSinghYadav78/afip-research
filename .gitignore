__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/
# Ignore ad-hoc run output at the top level of results/ (regenerated by
# run_demo.py / harness.py on every run) ...
results/*.csv
results/*.json
results/*.jsonl
!results/.gitkeep
# ... but keep committed, archived pilot/experiment run folders such as
# results/pilot_groq_llama33_2026-08-12/ -- these are permanent evidence
# artifacts, not regenerable scratch output.
!results/pilot_*/
!results/pilot_*/**
.env
